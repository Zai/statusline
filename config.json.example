{
  "separator": " | ",
  "plugins": [
    {
      "name": "directory",
      "icon": "📂",
      "options": {
        "showFullPath": true
      }
    },
    {
      "name": "git",
      "options": {
        "dirtyColor": "red"
      }
    },
    {
      "name": "claude-tokens",
      "icon": "📊",
      "color": "magenta",
      "options": {
        "format": "full"
      }
    }
  ]
}
